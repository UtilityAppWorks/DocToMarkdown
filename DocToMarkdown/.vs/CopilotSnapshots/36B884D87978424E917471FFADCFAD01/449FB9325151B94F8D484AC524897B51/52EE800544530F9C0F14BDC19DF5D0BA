        private void SaveMarkdownWithSplitting(string outputFolder, string baseFileName, string markdown)
        {
            const int chunkChars = 200_000;

            if (string.IsNullOrEmpty(markdown) || markdown.Length <= chunkChars)
            {
                string outputPath = Path.Combine(outputFolder, baseFileName + ".md");
                File.WriteAllText(outputPath, markdown ?? string.Empty, Encoding.UTF8);
                return;
            }

            string partsDir = Path.Combine(outputFolder, baseFileName + "_parts");
            Directory.CreateDirectory(partsDir);

            var index = new StringBuilder();
            index.AppendLine($"# {baseFileName}");
            index.AppendLine();
            index.AppendLine("> 大きなファイルのため、複数のMarkdownに分割して出力しました。");
            index.AppendLine();

            int partNo = 1;
            int pos = 0;
            while (pos < markdown.Length)
            {
                int len = Math.Min(chunkChars, markdown.Length - pos);

                if (pos + len < markdown.Length)
                {
                    int lastNewLine = markdown.LastIndexOf('\n', pos + len - 1, len);
                    if (lastNewLine > pos + 1000)
                    {
                        len = (lastNewLine - pos) + 1;
                    }
                }

                string partText = markdown.Substring(pos, len);
                string partFileName = $"{baseFileName}_part{partNo:000}.md";
                string partPath = Path.Combine(partsDir, partFileName);
                File.WriteAllText(partPath, partText, Encoding.UTF8);

                index.AppendLine($"- [{baseFileName} Part {partNo}]({baseFileName}_parts/{partFileName})");

                pos += len;
                partNo++;
                if (partNo > 9999) break;
            }

            string indexPath = Path.Combine(outputFolder, baseFileName + ".md");
            File.WriteAllText(indexPath, index.ToString(), Encoding.UTF8);
        }

        private Encoding DetectEncoding(string filePath)
        {
            byte[] bom = new byte[4];
            using (FileStream fs = new FileStream(filePath, FileMode.Open, FileAccess.Read))
            {
                fs.Read(bom, 0, Math.Min(4, (int)fs.Length));
            }

            if (bom[0] == 0xef && bom[1] == 0xbb && bom[2] == 0xbf)
                return Encoding.UTF8;
            if (bom[0] == 0xff && bom[1] == 0xfe)
                return Encoding.Unicode;
            if (bom[0] == 0xfe && bom[1] == 0xff)
                return Encoding.BigEndianUnicode;
            if (bom[0] == 0xff && bom[1] == 0xfe && bom[2] == 0 && bom[3] == 0)
                return Encoding.UTF32;

            try { return Encoding.GetEncoding("shift_jis"); }
            catch { return Encoding.UTF8; }
        }

        private string NormalizeDocExtractedText(string text)
        {
            if (string.IsNullOrEmpty(text)) return text;

            text = Regex.Replace(text, "[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]", "");
            text = Regex.Replace(text, "[\\uD800-\\uDFFF\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\uFEFF]", "");
            text = Regex.Replace(text, @"[ \t]+", " ");
            text = BreakLongTokens(text, 300);
            text = Regex.Replace(text, @"\r\n", "\n");
            text = Regex.Replace(text, @"\n{3,}", "\n\n");
            return text.Trim();
        }

        private string BreakLongTokens(string text, int maxTokenLength)
        {
            if (string.IsNullOrEmpty(text)) return text;

            var sb = new StringBuilder(text.Length);
            int tokenLen = 0;

            for (int i = 0; i < text.Length; i++)
            {
                char c = text[i];

                if (c == '\r' || c == '\n' || c == ' ' || c == '\t')
                {
                    sb.Append(c);
                    tokenLen = 0;
                    continue;
                }

                sb.Append(c);
                tokenLen++;

                if (tokenLen >= maxTokenLength)
                {
                    sb.Append('\n');
                    tokenLen = 0;
                }
            }

            return sb.ToString();
        }
    }
