        private string ExtractTextFromPdf(byte[] pdfBytes)
        {
            if (pdfBytes == null || pdfBytes.Length == 0) return string.Empty;

            try
            {
                using (MemoryStream ms = new MemoryStream(pdfBytes))
                {
                    using (StreamReader reader = new StreamReader(ms, Encoding.UTF8))
                    {
                        return reader.ReadToEnd();
                    }
                }
            }
            catch
            {
                return string.Empty;
            }
        }

        private static bool IsJapaneseCharLocal(char c)
        {
            return (c >= 0x3040 && c <= 0x309F) ||
                   (c >= 0x30A0 && c <= 0x30FF) ||
                   (c >= 0x4E00 && c <= 0x9FFF) ||
                   (c >= 0xFF00 && c <= 0xFFEF);
        }

        private static int GetVisualWidth(string s)
        {
            if (string.IsNullOrEmpty(s)) return 0;
            int w = 0;
            for (int i = 0; i < s.Length; i++)
            {
                char c = s[i];
                if (c == '\n' || c == '\r') continue;
                w += IsJapaneseCharLocal(c) ? 2 : 1;
            }
            return w;
        }

        private static bool EndsWithHardLineBreakPunctuation(string s)
        {
            if (string.IsNullOrEmpty(s)) return false;
            char c = s.TrimEnd().Last();
            return c == '。' || c == '、' || c == '．' || c == '，' || c == '.' || c == '!' || c == '?' || c == '！' || c == '？' || c == ':' || c == '：';
        }

        private static string FixSpacingAfterPunctuation(string line)
        {
            if (string.IsNullOrWhiteSpace(line)) return line;
            string s = line;
            s = Regex.Replace(s, @"([。、])\s+", "$1");
            s = Regex.Replace(s, @"([.!?;:])\s*", "$1 ");
            s = Regex.Replace(s, @"[ \t]{2,}", " ");
            return s.Trim();
        }

        private string WrapLineForPdfLocal(string line, int maxWidth)
        {
            if (string.IsNullOrWhiteSpace(line)) return line;
            if (maxWidth <= 10) return line;

            int visual = 0;
            int lastBreakableIndex = -1;

            var sb = new StringBuilder(line.Length + Math.Min(1024, line.Length / 4));

            for (int i = 0; i < line.Length; i++)
            {
                char c = line[i];
                sb.Append(c);

                if (c == '\n')
                {
                    visual = 0;
                    lastBreakableIndex = -1;
                    continue;
                }

                if (c == ' ' || c == '\t' || c == '・' || c == '。' || c == '！' || c == '？' || c == '.' || c == '!' || c == '?')
                {
                    lastBreakableIndex = sb.Length - 1;
                }

                visual += IsJapaneseCharLocal(c) ? 2 : 1;

                if (visual >= maxWidth)
                {
                    int breakAt = lastBreakableIndex;
                    if (breakAt < 0 || sb.Length - breakAt > maxWidth)
                    {
                        breakAt = sb.Length - 1;
                    }

                    if (breakAt >= 0 && breakAt + 1 < sb.Length)
                    {
                        sb.Insert(breakAt + 1, "\n");
                    }
                    else
                    {
                        sb.Append('\n');
                    }

                    visual = 0;
                    lastBreakableIndex = -1;
                }
            }

            return sb.ToString().TrimEnd();
        }

