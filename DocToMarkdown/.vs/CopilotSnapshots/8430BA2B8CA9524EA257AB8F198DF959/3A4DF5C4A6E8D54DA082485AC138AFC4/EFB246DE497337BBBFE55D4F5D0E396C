        private void SaveMarkdownWithSplitting(string outputFolder, string baseFileName, string markdown)
        {
            // 目安: 200KB を超えるとビューアによっては重くなりやすい
            const int chunkChars = 200_000;

            // 分割不要なら従来どおり
            if (string.IsNullOrEmpty(markdown) || markdown.Length <= chunkChars)
            {
                string outputPath = Path.Combine(outputFolder, baseFileName + ".md");
                File.WriteAllText(outputPath, markdown ?? string.Empty, Encoding.UTF8);
                return;
            }

            // 分割ファイルを格納するサブフォルダ
            string partsDir = Path.Combine(outputFolder, baseFileName + "_parts");
            Directory.CreateDirectory(partsDir);

            // 目次(親)Markdown
            var index = new StringBuilder();
            index.AppendLine($"# {baseFileName}");
            index.AppendLine();
            index.AppendLine("> 大きなファイルのため、複数のMarkdownに分割して出力しました。");
            index.AppendLine();

            int partNo = 1;
            int pos = 0;
            while (pos < markdown.Length)
            {
                int len = Math.Min(chunkChars, markdown.Length - pos);

                // なるべく改行境界で切る
                if (pos + len < markdown.Length)
                {
                    int lastNewLine = markdown.LastIndexOf('\n', pos + len - 1, len);
                    if (lastNewLine > pos + 1000) // 近すぎる切断は避ける
                    {
                        len = (lastNewLine - pos) + 1;
                    }
                }

                string partText = markdown.Substring(pos, len);
                string partFileName = $"{baseFileName}_part{partNo:000}.md";
                string partPath = Path.Combine(partsDir, partFileName);
                File.WriteAllText(partPath, partText, Encoding.UTF8);

                index.AppendLine($"- [{baseFileName} Part {partNo}]({baseFileName}_parts/{partFileName})");

                pos += len;
                partNo++;

                // 念のため上限
                if (partNo > 9999) break;
            }

            string indexPath = Path.Combine(outputFolder, baseFileName + ".md");
            File.WriteAllText(indexPath, index.ToString(), Encoding.UTF8);
        }

        private bool IsJapaneseChar(char c)
        {
            return (c >= 0x3040 && c <= 0x309F) || // ひらがな
                   (c >= 0x30A0 && c <= 0x30FF) || // カタカナ
                   (c >= 0x4E00 && c <= 0x9FFF) || // CJK統合漢字
                   (c >= 0xFF00 && c <= 0xFFEF);   // 全角記号
        }
    }
