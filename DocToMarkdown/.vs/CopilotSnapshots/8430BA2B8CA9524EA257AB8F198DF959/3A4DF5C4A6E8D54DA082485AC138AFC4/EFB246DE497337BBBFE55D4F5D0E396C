#if !PDFPIG
        // PdfPig未導入の場合の簡易PDF抽出（日本語PDFでは文字化けする可能性が高い）
        private string ExtractTextFromPdf(byte[] pdfBytes)
        {
            StringBuilder text = new StringBuilder();
            string content = Encoding.GetEncoding("ISO-8859-1").GetString(pdfBytes);

            var matches = Regex.Matches(content, @"BT\s*(.*?)\s*ET", RegexOptions.Singleline);

            foreach (Match match in matches)
            {
                string block = match.Groups[1].Value;

                var tjMatches = Regex.Matches(block, @"\((.*?)\)\s*Tj", RegexOptions.Singleline);
                foreach (Match tj in tjMatches)
                {
                    string extracted = DecodePdfTextString(tj.Groups[1].Value);
                    if (!string.IsNullOrWhiteSpace(extracted))
                    {
                        text.Append(extracted);
                    }
                }

                var tjHexMatches = Regex.Matches(block, @"<([0-9A-Fa-f\s]+)>\s*Tj", RegexOptions.Singleline);
                foreach (Match tjHex in tjHexMatches)
                {
                    string extracted = DecodePdfHexString(tjHex.Groups[1].Value);
                    if (!string.IsNullOrWhiteSpace(extracted))
                    {
                        text.Append(extracted);
                    }
                }

                var tjArrayMatches = Regex.Matches(block, @"\[(.*?)\]\s*TJ", RegexOptions.Singleline);
                foreach (Match tjArray in tjArrayMatches)
                {
                    string arrayBody = tjArray.Groups[1].Value;

                    var stringMatches = Regex.Matches(arrayBody, @"\((.*?)\)", RegexOptions.Singleline);
                    foreach (Match str in stringMatches)
                    {
                        string extracted = DecodePdfTextString(str.Groups[1].Value);
                        if (!string.IsNullOrWhiteSpace(extracted))
                        {
                            text.Append(extracted);
                        }
                    }

                    var hexMatches = Regex.Matches(arrayBody, @"<([0-9A-Fa-f\s]+)>", RegexOptions.Singleline);
                    foreach (Match hex in hexMatches)
                    {
                        string extracted = DecodePdfHexString(hex.Groups[1].Value);
                        if (!string.IsNullOrWhiteSpace(extracted))
                        {
                            text.Append(extracted);
                        }
                    }
                }

                if (Regex.IsMatch(block, @"\d+\s+\d+\s+T[dD]"))
                {
                    text.AppendLine();
                }
            }

            return CleanExtractedTextLocal(text.ToString());
        }
#endif

        private string DecodePdfTextString(string input)
        {
            StringBuilder result = new StringBuilder();

            for (int i = 0; i < input.Length; i++)
            {
                char c = input[i];

                if (c == '\\' && i + 1 < input.Length)
                {
                    char next = input[i + 1];
                    switch (next)
                    {
                        case 'n': result.Append('\n'); i++; break;
                        case 'r': result.Append('\r'); i++; break;
                        case 't': result.Append('\t'); i++; break;
                        case 'b': result.Append('\b'); i++; break;
                        case 'f': result.Append('\f'); i++; break;
                        case '\\':
                        case '(':
                        case ')':
                            result.Append(next); i++; break;
                        default:
                            if (next >= '0' && next <= '7')
                            {
                                string octal = "";
                                int j = i + 1;
                                while (j < input.Length && j < i + 4)
                                {
                                    char d = input[j];
                                    if (d < '0' || d > '7') break;
                                    octal += d;
                                    j++;
                                }

                                if (octal.Length > 0)
                                {
                                    result.Append((char)Convert.ToInt32(octal, 8));
                                    i = j - 1;
                                }
                            }
                            break;
                    }
                }
                else
                {
                    result.Append(c);
                }
            }

            return result.ToString();
        }

        private string DecodePdfHexString(string hex)
        {
            string normalized = Regex.Replace(hex, @"\s+", "");
            if (normalized.Length == 0) return "";

            if (normalized.Length % 2 == 1)
            {
                normalized += "0";
            }

            byte[] bytes = new byte[normalized.Length / 2];
            for (int i = 0; i < bytes.Length; i++)
            {
                bytes[i] = Convert.ToByte(normalized.Substring(i * 2, 2), 16);
            }

            if (bytes.Length >= 2 && bytes[0] == 0xFE && bytes[1] == 0xFF)
            {
                return Encoding.BigEndianUnicode.GetString(bytes, 2, bytes.Length - 2);
            }
            if (bytes.Length >= 2 && bytes[0] == 0xFF && bytes[1] == 0xFE)
            {
                return Encoding.Unicode.GetString(bytes, 2, bytes.Length - 2);
            }
            if (bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
            {
                return Encoding.UTF8.GetString(bytes, 3, bytes.Length - 3);
            }

            return Encoding.GetEncoding("ISO-8859-1").GetString(bytes);
        }

        private Encoding DetectEncoding(string filePath)
        {
            byte[] bom = new byte[4];
            using (FileStream fs = new FileStream(filePath, FileMode.Open, FileAccess.Read))
            {
                fs.Read(bom, 0, Math.Min(4, (int)fs.Length));
            }

            if (bom[0] == 0xef && bom[1] == 0xbb && bom[2] == 0xbf)
                return Encoding.UTF8;
            if (bom[0] == 0xff && bom[1] == 0xfe)
                return Encoding.Unicode;
            if (bom[0] == 0xfe && bom[1] == 0xff)
                return Encoding.BigEndianUnicode;
            if (bom[0] == 0xff && bom[1] == 0xfe && bom[2] == 0 && bom[3] == 0)
                return Encoding.UTF32;

            try
            {
                return Encoding.GetEncoding("shift_jis");
            }
            catch
            {
                return Encoding.UTF8;
            }
        }

