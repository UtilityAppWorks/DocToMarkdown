        private async void btnConvert_Click(object sender, EventArgs e)
        {
            if (selectedFiles.Count == 0)
            {
                MessageBox.Show("変換するファイルを選択してください。", "エラー", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (string.IsNullOrEmpty(txtOutputFolder.Text))
            {
                MessageBox.Show("出力先フォルダを選択してください。", "エラー", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            btnConvert.Enabled = false;
            btnSelectFiles.Enabled = false;
            btnSelectOutputFolder.Enabled = false;
            btnClearFiles.Enabled = false;
            progressBar.Value = 0;
            progressBar.Maximum = selectedFiles.Count;
            txtLog.Clear();

            int successCount = 0;
            int failCount = 0;
            string outputFolder = txtOutputFolder.Text;
            List<string> filesToProcess = new List<string>(selectedFiles);

            await Task.Run(() =>
            {
                for (int i = 0; i < filesToProcess.Count; i++)
                {
                    string file = filesToProcess[i];
                    string fileName = Path.GetFileNameWithoutExtension(file);
                    string extension = Path.GetExtension(file).ToLower();
                    string outputPath = Path.Combine(outputFolder, fileName + ".md");

                    UpdateStatus($"変換中: {Path.GetFileName(file)} ({i + 1}/{filesToProcess.Count})");

                    try
                    {
                        string markdown = ConvertToMarkdown(file, extension);

                        // 大きすぎるMarkdownは分割して保存（ビューアのフリーズ回避）
                        SaveMarkdownWithSplitting(outputFolder, fileName, markdown);

                        AppendLog($"[成功] {Path.GetFileName(file)} → {fileName}.md");
                        successCount++;
                    }
                    catch (Exception ex)
                    {
                        AppendLog($"[失敗] {Path.GetFileName(file)}: {ex.Message}");
                        failCount++;
                    }

                    UpdateProgress(i + 1);
                }
            });

            UpdateStatus($"完了: 成功 {successCount} 件, 失敗 {failCount} 件");

            btnConvert.Enabled = true;
            btnSelectFiles.Enabled = true;
            btnSelectOutputFolder.Enabled = true;
            btnClearFiles.Enabled = true;

            MessageBox.Show($"変換が完了しました。\n成功: {successCount} 件\n失敗: {failCount} 件",
                "完了", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private string ConvertToMarkdown(string filePath, string extension)
        {
            switch (extension)
            {
                case ".txt":
                    return ConvertTxtToMarkdown(filePath);
                case ".docx":
                    return ConvertDocxToMarkdown(filePath);
                case ".doc":
                    return ConvertDocToMarkdown(filePath);
                case ".pdf":
                    return ConvertPdfToMarkdown(filePath);
                default:
                    throw new NotSupportedException($"未対応のファイル形式: {extension}");
            }
        }

        private string ConvertTxtToMarkdown(string filePath)
        {
            string content = File.ReadAllText(filePath, DetectEncoding(filePath));
            StringBuilder markdown = new StringBuilder();

            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();

            string[] lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
            foreach (string line in lines)
            {
                markdown.AppendLine(line);
            }

            return markdown.ToString();
        }

        private string ConvertDocxToMarkdown(string filePath)
        {
            StringBuilder markdown = new StringBuilder();
            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();

            string tempDir = null;
            try
            {
                // .docxはZIPファイル形式。一時フォルダに展開してXMLを読み取る
                tempDir = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
                Directory.CreateDirectory(tempDir);

                // ZIPとして展開
                ExtractDocx(filePath, tempDir);

                string documentPath = Path.Combine(tempDir, "word", "document.xml");
                if (File.Exists(documentPath))
                {
                    XDocument doc = XDocument.Load(documentPath);
                    XNamespace w = "http://schemas.openxmlformats.org/wordprocessingml/2006/main";

                    var paragraphs = doc.Descendants(w + "p");
                    bool inList = false;

                    foreach (var para in paragraphs)
                    {
                        // スタイル情報を取得
                        var pStyle = para.Element(w + "pPr")?.Element(w + "pStyle")?.Attribute(w + "val")?.Value ?? "";
                        var numPr = para.Element(w + "pPr")?.Element(w + "numPr");

                        // 書式付きテキストを処理
                        string text = ProcessFormattedText(para, w);

                        if (string.IsNullOrWhiteSpace(text))
                        {
                            if (inList)
                            {
                                inList = false;
                            }
                            markdown.AppendLine();
                            continue;
                        }

                        // 見出しスタイルの処理
                        if (pStyle.StartsWith("Heading") || pStyle.StartsWith("見出し"))
                        {
                            int level = 1;
                            string digits = new string(pStyle.Where(char.IsDigit).ToArray());
                            if (!string.IsNullOrEmpty(digits))
                            {
                                level = int.Parse(digits.Substring(0, 1));
                            }
                            markdown.AppendLine($"{new string('#', Math.Min(level, 6))} {text}");
                            markdown.AppendLine();
                        }
                        // 番号付きリスト
                        else if (numPr != null)
                        {
                            var ilvl = numPr.Element(w + "ilvl")?.Attribute(w + "val")?.Value;
                            int indent = 0;
                            if (ilvl != null) int.TryParse(ilvl, out indent);
                            string prefix = new string(' ', indent * 2);
                            markdown.AppendLine($"{prefix}- {text}");
                            inList = true;
                        }
                        else
                        {
                            if (inList)
                            {
                                markdown.AppendLine();
                                inList = false;
                            }
                            markdown.AppendLine(text);
                            markdown.AppendLine();
                        }
                    }

                    // テーブルの処理
                    var tables = doc.Descendants(w + "tbl");
                    foreach (var table in tables)
                    {
                        markdown.AppendLine();
                        markdown.AppendLine(ConvertTableToMarkdown(table, w));
                        markdown.AppendLine();
                    }
                }
            }
            catch (Exception ex)
            {
                markdown.AppendLine($"> 変換中にエラーが発生しました: {ex.Message}");
            }
            finally
            {
                // 一時フォルダを削除
                if (tempDir != null && Directory.Exists(tempDir))
                {
                    try { Directory.Delete(tempDir, true); } catch { }
                }
            }

            return markdown.ToString();
        }

        private void ExtractDocx(string zipPath, string extractPath)
        {
            // .NET Framework 4.5以降のZipFileを使わずにShellを使用して展開
            // またはバイナリレベルでZIPを解析

            // まず、ファイルを.zip拡張子でコピー
            string tempZip = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString() + ".zip");
            File.Copy(zipPath, tempZip, true);

            try
            {
                // Shell32を使用してZIPを展開
                Type shellType = Type.GetTypeFromProgID("Shell.Application");
                dynamic shell = Activator.CreateInstance(shellType);

                dynamic zipFolder = shell.NameSpace(tempZip);
                dynamic destFolder = shell.NameSpace(extractPath);

                if (zipFolder != null && destFolder != null)
                {
                    destFolder.CopyHere(zipFolder.Items(), 4 | 16); // 4=確認なし, 16=すべて上書き
                    
                    // コピー完了を待つ
                    System.Threading.Thread.Sleep(500);
                }

                Marshal.ReleaseComObject(shell);
            }
            finally
            {
                // 一時ZIPファイルを削除
                try { File.Delete(tempZip); } catch { }
            }
        }

        private string ProcessFormattedText(XElement para, XNamespace w)
        {
            StringBuilder result = new StringBuilder();

            foreach (var run in para.Descendants(w + "r"))
            {
                var rPr = run.Element(w + "rPr");
                bool isBold = rPr?.Element(w + "b") != null;
                bool isItalic = rPr?.Element(w + "i") != null;
                bool isStrike = rPr?.Element(w + "strike") != null;

                StringBuilder runText = new StringBuilder();
                foreach (var child in run.Elements())
                {
                    if (child.Name == w + "t")
                    {
                        runText.Append(child.Value);
                    }
                    else if (child.Name == w + "tab")
                    {
                        runText.Append("\t");
                    }
                    else if (child.Name == w + "br")
                    {
                        runText.Append("\n");
                    }
                }

                string text = runText.ToString();
                if (string.IsNullOrEmpty(text)) continue;

                if (isStrike)
                {
                    text = $"~~{text}~~";
                }
                if (isBold && isItalic)
                {
                    text = $"***{text}***";
                }
                else if (isBold)
                {
                    text = $"**{text}**";
                }
                else if (isItalic)
                {
                    text = $"*{text}*";
                }

                result.Append(text);
            }

            return result.ToString();
        }

        private string ConvertTableToMarkdown(XElement table, XNamespace w)
        {
            StringBuilder sb = new StringBuilder();
            var rows = table.Elements(w + "tr").ToList();

            if (rows.Count == 0) return "";

            // ヘッダー行
            var headerCells = rows[0].Elements(w + "tc").ToList();
            sb.Append("|");
            foreach (var cell in headerCells)
            {
                string cellText = GetCellText(cell, w);
                sb.Append($" {cellText} |");
            }
            sb.AppendLine();

            // 区切り行
            sb.Append("|");
            foreach (var cell in headerCells)
            {
                sb.Append(" --- |");
            }
            sb.AppendLine();

            // データ行
            for (int i = 1; i < rows.Count; i++)
            {
                var cells = rows[i].Elements(w + "tc").ToList();
                sb.Append("|");
                foreach (var cell in cells)
                {
                    string cellText = GetCellText(cell, w);
                    sb.Append($" {cellText} |");
                }
                sb.AppendLine();
            }

            return sb.ToString();
        }

        private string GetCellText(XElement cell, XNamespace w)
        {
            StringBuilder text = new StringBuilder();
            foreach (var t in cell.Descendants(w + "t"))
            {
                text.Append(t.Value);
            }
            return text.ToString().Trim().Replace("|", "\\|");
        }

        private string ConvertDocToMarkdown(string filePath)
        {
            StringBuilder markdown = new StringBuilder();
            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();
            markdown.AppendLine("> 注意: .doc形式は限定的なサポートです。より良い結果を得るには.docx形式に変換してください。");
            markdown.AppendLine("> この形式は疑似抽出のため、結果が不安定/巨大になることがあります。問題がある場合は .docx へ変換してください。");
            markdown.AppendLine();

            try
            {
                byte[] bytes = File.ReadAllBytes(filePath);

                // フリーズ回避のため、.doc は全文ではなくプレビュー（先頭のみ）を出力する
                // サイズが大きい場合でも先頭部分の抽出は試みる
                string content = ExtractTextFromDoc(bytes);
                content = NormalizeDocExtractedText(content);

                if (string.IsNullOrWhiteSpace(content))
                {
                    markdown.AppendLine("> この .doc からテキストを抽出できませんでした。");
                    markdown.AppendLine("> 対策: Wordで .docx に変換してから再変換してください。");
                    return markdown.ToString();
                }

                // 抽出結果が危険そうな場合は「先頭だけ」出す
                const int previewChars = 50_000;
                const int previewLines = 1_000;

                bool suppressed = IsProbablyBinaryGarbage(content);
                string preview = content;
                if (preview.Length > previewChars)
                {
                    preview = preview.Substring(0, previewChars);
                    suppressed = true;
                }

                int lineCount = 0;
                using (var reader = new StringReader(preview))
                {
                    string line;
                    while ((line = reader.ReadLine()) != null)
                    {
                        if (lineCount >= previewLines)
                        {
                            suppressed = true;
                            break;
                        }

                        if (!string.IsNullOrWhiteSpace(line))
                        {
                            markdown.AppendLine(line.Trim());
                            markdown.AppendLine();
                        }
                        else
                        {
                            markdown.AppendLine();
                        }

                        lineCount++;
                    }
                }

                if (suppressed)
                {
                    markdown.AppendLine("> [省略] .doc の抽出結果が大きい/ノイズが多い可能性があるため、先頭部分のみ出力しました。");
                    markdown.AppendLine("> 対策: Wordで .docx に変換してから再変換してください。");
                }
            }
            catch (Exception ex)
            {
                markdown.AppendLine($"> テキスト抽出エラー: {ex.Message}");
            }

            return markdown.ToString();
        }

        private bool IsProbablyBinaryGarbage(string text)
        {
            if (string.IsNullOrEmpty(text)) return true;

            // まだ長すぎるものは危険（ビューア側の負荷が高い）
            if (text.Length > 300_000) return true;

            // 改行が極端に少ない＝巨大な1塊の可能性
            int newlines = text.Count(c => c == '\n');
            if (newlines < 5 && text.Length > 10_000) return true;

            // 高エントロピーっぽい（英数記号の比率が高すぎる）場合はゴミの可能性が高い
            int ascii = 0;
            int total = 0;
            foreach (char c in text)
            {
                if (c == '\r' || c == '\n' || c == '\t') continue;
                total++;
                if (c >= 32 && c <= 126) ascii++;
                if (total >= 50_000) break;
            }

            if (total > 0)
            {
                double ratio = (double)ascii / total;
                if (ratio > 0.95) return true;
            }

            return false;
        }

        private string NormalizeDocExtractedText(string text)
        {
            if (string.IsNullOrEmpty(text)) return text;

            // 制御文字/NULL を落とす（改行とタブは残す）
            text = Regex.Replace(text, "[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]", "");

            // サロゲート/不可視系(ゼロ幅等)を落とす（ビューアが不安定になることがある）
            text = Regex.Replace(text, "[\\uD800-\\uDFFF\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\uFEFF]", "");

            // 連続スペース整理
            text = Regex.Replace(text, @"[ \t]+", " ");

            // 明らかなバイナリ断片っぽいもの（Base64風の超長連続）を除去
            text = Regex.Replace(text, @"[A-Za-z0-9+/]{800,}={0,2}", "[BINARY_OMITTED]");

            // 記号の過剰な連続（罫線/ゴミ）を短縮
            text = Regex.Replace(text, @"([=_\-#*`~\|\\/\.])\1{30,}", "$1$1$1$1$1...");

            // 異常に長いトークン(空白なし)を分割（Markdownビューアのフリーズ回避）
            text = BreakLongTokens(text, 300);

            // 異常に長い 1 行を分割
            const int maxLineLength = 1200;
            var sb = new StringBuilder(Math.Min(text.Length, 2_100_000));
            using (var reader = new StringReader(text))
            {
                string line;
                while ((line = reader.ReadLine()) != null)
                {
                    if (line.Length <= maxLineLength)
                    {
                        sb.AppendLine(line);
                        continue;
                    }

                    int idx = 0;
                    while (idx < line.Length)
                    {
                        int len = Math.Min(maxLineLength, line.Length - idx);
                        sb.AppendLine(line.Substring(idx, len));
                        idx += len;
                    }
                }
            }

            // 最大出力サイズ制限（巨大な .doc で .md が重くなるのを回避）
            const int maxChars = 800_000;
            string normalized = sb.ToString();
            if (normalized.Length > maxChars)
            {
                normalized = normalized.Substring(0, maxChars) + "\n\n> [省略] 抽出テキストが大きすぎるため末尾を切り詰めました。\n";
            }

            // 空行の正規化
            normalized = Regex.Replace(normalized, @"\n{3,}", "\n\n");

            return normalized.Trim();
        }

        private string BreakLongTokens(string text, int maxTokenLength)
        {
            if (string.IsNullOrEmpty(text)) return text;

            var sb = new StringBuilder(text.Length);
            int tokenLen = 0;

            for (int i = 0; i < text.Length; i++)
            {
                char c = text[i];

                // 改行/空白/タブはトークン区切り
                if (c == '\r' || c == '\n' || c == ' ' || c == '\t')
                {
                    sb.Append(c);
                    tokenLen = 0;
                    continue;
                }

                sb.Append(c);
                tokenLen++;

                if (tokenLen >= maxTokenLength)
                {
                    sb.Append('\n');
                    tokenLen = 0;
                }
            }

            return sb.ToString();
        }

        private string ExtractTextFromDoc(byte[] bytes)
        {
            // .doc はOLE形式で、単純にテキストだけが入っているわけではないため
            // 「文字列っぽい区間」を複数の方法で拾って結合する（完全な抽出ではない）

            var sb = new StringBuilder();

            // 1) UTF-16LEとして読める区間を優先的に拾う（日本語Wordで比較的当たりやすい）
            sb.AppendLine(ExtractUtf16LeStrings(bytes));

            // 2) フォールバック: Shift-JISとして読める区間を拾う（古い文書向け）
            sb.AppendLine(ExtractShiftJisStrings(bytes));

            return CleanExtractedTextLocal(sb.ToString());
        }

        private string ExtractUtf16LeStrings(byte[] bytes)
        {
            var text = new StringBuilder();
            var current = new StringBuilder();

            for (int i = 0; i + 1 < bytes.Length; i += 2)
            {
                ushort u = (ushort)(bytes[i] | (bytes[i + 1] << 8));
                char c = (char)u;

                // printable / whitespace / Japanese
                if (c == '\r' || c == '\n' || c == '\t' || c == ' ' ||
                    (c >= 0x20 && c <= 0x7E) || IsJapaneseChar(c))
                {
                    current.Append(c);
                }
                else
                {
                    FlushIfUseful(current, text);
                }
            }

            FlushIfUseful(current, text);
            return text.ToString();
        }

        private string ExtractShiftJisStrings(byte[] bytes)
        {
            var text = new StringBuilder();
            var buf = new List<byte>(256);

            // ざっくり「文字っぽい」バイト列だけを溜めてデコード
            for (int i = 0; i < bytes.Length; i++)
            {
                byte b = bytes[i];

                bool likelyText = (b >= 0x20 && b <= 0x7E) || b == 0x09 || b == 0x0A || b == 0x0D || b >= 0x80;
                if (likelyText)
                {
                    buf.Add(b);
                    if (buf.Count > 4096)
                    {
                        FlushShiftJis(buf, text);
                    }
                }
                else
                {
                    FlushShiftJis(buf, text);
                }
            }

            FlushShiftJis(buf, text);
            return text.ToString();
        }

        private void FlushIfUseful(StringBuilder current, StringBuilder output)
        {
            if (current.Length > 8)
            {
                output.AppendLine(current.ToString());
            }
            current.Clear();
        }

        private void FlushShiftJis(List<byte> buf, StringBuilder output)
        {
            if (buf.Count == 0) return;

            if (buf.Count > 16)
            {
                try
                {
                    string s = Encoding.GetEncoding("shift_jis").GetString(buf.ToArray());
                    if (!string.IsNullOrWhiteSpace(s))
                    {
                        output.AppendLine(s);
                    }
                }
                catch
                {
                    // ignore
                }
            }

            buf.Clear();
        }

        private string ConvertPdfToMarkdown(string filePath)
        {
            StringBuilder markdown = new StringBuilder();
            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();

            try
            {
#if PDFPIG
                AppendLog("[PDF] PdfPigで抽出します");
                string pdfText = ExtractTextFromPdfWithPdfPig(filePath);

                // PdfPigの抽出結果がPDFの生データ(構造)っぽい場合は、抽出失敗として扱う
                // （endstream/endobjが大量に出るのは本文ではない）
                if (!string.IsNullOrWhiteSpace(pdfText) &&
                    (pdfText.Contains("endstream") || pdfText.Contains("endobj") || pdfText.Contains("xref") || pdfText.Contains("%%EOF")))
                {
                    AppendLog("[PDF] PdfPig抽出結果がPDF構造っぽいため、抽出失敗として扱います");
                    pdfText = null;
                }
#else
                AppendLog("[PDF] 簡易抽出で抽出します（文字化けする可能性があります）");
                byte[] pdfBytes = File.ReadAllBytes(filePath);
                string pdfText = ExtractTextFromPdf(pdfBytes);
#endif

                if (string.IsNullOrWhiteSpace(pdfText))
                {
                    markdown.AppendLine("> このPDFからテキストを抽出できませんでした。");
                    markdown.AppendLine("> （フォント埋め込み/ToUnicode未設定等により抽出不可の場合があります）");
                    markdown.AppendLine("> 回避策: PDFを『テキストとしてコピーできる形式』で再出力する、または別のPDF抽出ライブラリを検討してください。");
                }
                else
                {
                    string[] lines = pdfText.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
                    foreach (string line in lines)
                    {
                        string trimmedLine = line.TrimEnd();
                        if (!string.IsNullOrWhiteSpace(trimmedLine))
                        {
                            markdown.AppendLine(trimmedLine);
                        }
                        else
                        {
                            markdown.AppendLine();
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                markdown.AppendLine($"> PDF読み取りエラー: {ex.Message}");
                AppendLog($"[PDF] 例外: {ex.GetType().Name}: {ex.Message}");
            }

            return markdown.ToString();
        }

