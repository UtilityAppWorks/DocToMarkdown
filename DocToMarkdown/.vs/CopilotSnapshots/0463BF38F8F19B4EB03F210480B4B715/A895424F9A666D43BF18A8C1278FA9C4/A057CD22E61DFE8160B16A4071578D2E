        private void btnSelectFiles_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog openFileDialog = new OpenFileDialog())
            {
                openFileDialog.Filter = "対応ファイル (*.pdf;*.docx;*.doc;*.txt)|*.pdf;*.docx;*.doc;*.txt|" +
                                        "PDF ファイル (*.pdf)|*.pdf|" +
                                        "Word ファイル (*.docx;*.doc)|*.docx;*.doc|" +
                                        "テキストファイル (*.txt)|*.txt|" +
                                        "すべてのファイル (*.*)|*.*";
                openFileDialog.Multiselect = true;
                openFileDialog.Title = "変換するファイルを選択";

                if (openFileDialog.ShowDialog() == DialogResult.OK)
                {
                    foreach (string file in openFileDialog.FileNames)
                    {
                        if (!selectedFiles.Contains(file))
                        {
                            selectedFiles.Add(file);
                            listBoxFiles.Items.Add(file);
                        }
                    }
                    txtInputFiles.Text = $"{selectedFiles.Count} ファイル選択中";
                }
            }
        }

        private void btnSelectOutputFolder_Click(object sender, EventArgs e)
        {
            using (FolderBrowserDialog folderDialog = new FolderBrowserDialog())
            {
                folderDialog.Description = "出力先フォルダを選択してください";
                folderDialog.ShowNewFolderButton = true;

                if (folderDialog.ShowDialog() == DialogResult.OK)
                {
                    txtOutputFolder.Text = folderDialog.SelectedPath;
                }
            }
        }

        private void btnClearFiles_Click(object sender, EventArgs e)
        {
            selectedFiles.Clear();
            listBoxFiles.Items.Clear();
            txtInputFiles.Text = "";
        }

        private async void btnConvert_Click(object sender, EventArgs e)
        {
            if (selectedFiles.Count == 0)
            {
                MessageBox.Show("変換するファイルを選択してください。", "エラー", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (string.IsNullOrEmpty(txtOutputFolder.Text))
            {
                MessageBox.Show("出力先フォルダを選択してください。", "エラー", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            btnConvert.Enabled = false;
            btnSelectFiles.Enabled = false;
            btnSelectOutputFolder.Enabled = false;
            btnClearFiles.Enabled = false;
            progressBar.Value = 0;
            progressBar.Maximum = selectedFiles.Count;
            txtLog.Clear();

            int successCount = 0;
            int failCount = 0;

            await Task.Run(() =>
            {
                for (int i = 0; i < selectedFiles.Count; i++)
                {
                    string file = selectedFiles[i];
                    string fileName = Path.GetFileNameWithoutExtension(file);
                    string extension = Path.GetExtension(file).ToLower();
                    string outputPath = Path.Combine(txtOutputFolder.Text, fileName + ".md");

                    UpdateStatus($"変換中: {Path.GetFileName(file)} ({i + 1}/{selectedFiles.Count})");

                    try
                    {
                        string markdown = ConvertToMarkdown(file, extension);
                        File.WriteAllText(outputPath, markdown, Encoding.UTF8);
                        AppendLog($"[成功] {Path.GetFileName(file)} → {fileName}.md");
                        successCount++;
                    }
                    catch (Exception ex)
                    {
                        AppendLog($"[失敗] {Path.GetFileName(file)}: {ex.Message}");
                        failCount++;
                    }

                    UpdateProgress(i + 1);
                }
            });

            UpdateStatus($"完了: 成功 {successCount} 件, 失敗 {failCount} 件");

            btnConvert.Enabled = true;
            btnSelectFiles.Enabled = true;
            btnSelectOutputFolder.Enabled = true;
            btnClearFiles.Enabled = true;

            MessageBox.Show($"変換が完了しました。\n成功: {successCount} 件\n失敗: {failCount} 件",
                "完了", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private string ConvertToMarkdown(string filePath, string extension)
        {
            switch (extension)
            {
                case ".txt":
                    return ConvertTxtToMarkdown(filePath);
                case ".docx":
                    return ConvertDocxToMarkdown(filePath);
                case ".doc":
                    return ConvertDocToMarkdown(filePath);
                case ".pdf":
                    return ConvertPdfToMarkdown(filePath);
                default:
                    throw new NotSupportedException($"未対応のファイル形式: {extension}");
            }
        }

        private string ConvertTxtToMarkdown(string filePath)
        {
            string content = File.ReadAllText(filePath, DetectEncoding(filePath));
            StringBuilder markdown = new StringBuilder();

            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();

            string[] lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
            foreach (string line in lines)
            {
                markdown.AppendLine(line);
            }

            return markdown.ToString();
        }

        private string ConvertDocxToMarkdown(string filePath)
        {
            StringBuilder markdown = new StringBuilder();
            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();

            try
            {
                // .docxはZIPファイル形式。word/document.xmlを読み取る
                using (ZipArchive archive = ZipFile.OpenRead(filePath))
                {
                    ZipArchiveEntry documentEntry = archive.GetEntry("word/document.xml");
                    if (documentEntry != null)
                    {
                        using (Stream stream = documentEntry.Open())
                        {
                            XDocument doc = XDocument.Load(stream);
                            XNamespace w = "http://schemas.openxmlformats.org/wordprocessingml/2006/main";

                            var paragraphs = doc.Descendants(w + "p");
                            bool inList = false;
                            int listLevel = 0;

                            foreach (var para in paragraphs)
                            {
                                // スタイル情報を取得
                                var pStyle = para.Element(w + "pPr")?.Element(w + "pStyle")?.Attribute(w + "val")?.Value ?? "";
                                var numPr = para.Element(w + "pPr")?.Element(w + "numPr");
                                
                                // テキストを取得（タブや改行を含む）
                                StringBuilder paraText = new StringBuilder();
                                foreach (var run in para.Descendants(w + "r"))
                                {
                                    foreach (var child in run.Elements())
                                    {
                                        if (child.Name == w + "t")
                                        {
                                            paraText.Append(child.Value);
                                        }
                                        else if (child.Name == w + "tab")
                                        {
                                            paraText.Append("\t");
                                        }
                                        else if (child.Name == w + "br")
                                        {
                                            paraText.Append("\n");
                                        }
                                    }
                                }

                                string text = paraText.ToString().Trim();

                                if (string.IsNullOrEmpty(text))
                                {
                                    if (inList)
                                    {
                                        inList = false;
                                    }
                                    markdown.AppendLine();
                                    continue;
                                }

                                // 書式付きテキストを処理
                                text = ProcessFormattedText(para, w);

                                // 見出しスタイルの処理
                                if (pStyle.StartsWith("Heading") || pStyle.StartsWith("見出し"))
                                {
                                    int level = 1;
                                    if (pStyle.Length > 7 && char.IsDigit(pStyle[7]))
                                    {
                                        level = int.Parse(pStyle[7].ToString());
                                    }
                                    else if (pStyle.Length > 3 && char.IsDigit(pStyle[3]))
                                    {
                                        level = int.Parse(pStyle[3].ToString());
                                    }
                                    markdown.AppendLine($"{new string('#', Math.Min(level, 6))} {text}");
                                    markdown.AppendLine();
                                }
                                // 番号付きリスト
                                else if (numPr != null)
                                {
                                    var ilvl = numPr.Element(w + "ilvl")?.Attribute(w + "val")?.Value;
                                    int indent = ilvl != null ? int.Parse(ilvl) : 0;
                                    string prefix = new string(' ', indent * 2);
                                    markdown.AppendLine($"{prefix}- {text}");
                                    inList = true;
                                }
                                else
                                {
                                    if (inList)
                                    {
                                        markdown.AppendLine();
                                        inList = false;
                                    }
                                    markdown.AppendLine(text);
                                    markdown.AppendLine();
                                }
                            }

                            // テーブルの処理
                            var tables = doc.Descendants(w + "tbl");
                            foreach (var table in tables)
                            {
                                markdown.AppendLine();
                                markdown.AppendLine(ConvertTableToMarkdown(table, w));
                                markdown.AppendLine();
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                markdown.AppendLine($"> 変換中にエラーが発生しました: {ex.Message}");
            }

            return markdown.ToString();
        }

        private string ProcessFormattedText(XElement para, XNamespace w)
        {
            StringBuilder result = new StringBuilder();

            foreach (var run in para.Descendants(w + "r"))
            {
                var rPr = run.Element(w + "rPr");
                bool isBold = rPr?.Element(w + "b") != null;
                bool isItalic = rPr?.Element(w + "i") != null;
                bool isStrike = rPr?.Element(w + "strike") != null;

                StringBuilder runText = new StringBuilder();
                foreach (var child in run.Elements())
                {
                    if (child.Name == w + "t")
                    {
                        runText.Append(child.Value);
                    }
                }

                string text = runText.ToString();
                if (string.IsNullOrEmpty(text)) continue;

                if (isStrike)
                {
                    text = $"~~{text}~~";
                }
                if (isBold && isItalic)
                {
                    text = $"***{text}***";
                }
                else if (isBold)
                {
                    text = $"**{text}**";
                }
                else if (isItalic)
                {
                    text = $"*{text}*";
                }

                result.Append(text);
            }

            return result.ToString();
        }

        private string ConvertTableToMarkdown(XElement table, XNamespace w)
        {
            StringBuilder sb = new StringBuilder();
            var rows = table.Elements(w + "tr").ToList();

            if (rows.Count == 0) return "";

            // ヘッダー行
            var headerCells = rows[0].Elements(w + "tc").ToList();
            sb.Append("|");
            foreach (var cell in headerCells)
            {
                string cellText = GetCellText(cell, w);
                sb.Append($" {cellText} |");
            }
            sb.AppendLine();

            // 区切り行
            sb.Append("|");
            foreach (var cell in headerCells)
            {
                sb.Append(" --- |");
            }
            sb.AppendLine();

            // データ行
            for (int i = 1; i < rows.Count; i++)
            {
                var cells = rows[i].Elements(w + "tc").ToList();
                sb.Append("|");
                foreach (var cell in cells)
                {
                    string cellText = GetCellText(cell, w);
                    sb.Append($" {cellText} |");
                }
                sb.AppendLine();
            }

            return sb.ToString();
        }

        private string GetCellText(XElement cell, XNamespace w)
        {
            StringBuilder text = new StringBuilder();
            foreach (var t in cell.Descendants(w + "t"))
            {
                text.Append(t.Value);
            }
            return text.ToString().Trim().Replace("|", "\\|");
        }

        private string ConvertDocToMarkdown(string filePath)
        {
            StringBuilder markdown = new StringBuilder();
            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();
            markdown.AppendLine("> 注意: .doc形式は限定的なサポートです。より良い結果を得るには.docx形式に変換してください。");
            markdown.AppendLine();

            try
            {
                // バイナリからテキストを抽出
                byte[] bytes = File.ReadAllBytes(filePath);
                string content = ExtractTextFromDoc(bytes);
                
                string[] lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
                foreach (string line in lines)
                {
                    if (!string.IsNullOrWhiteSpace(line))
                    {
                        markdown.AppendLine(line.Trim());
                        markdown.AppendLine();
                    }
                }
            }
            catch (Exception ex)
            {
                markdown.AppendLine($"> テキスト抽出エラー: {ex.Message}");
            }

            return markdown.ToString();
        }

        private string ExtractTextFromDoc(byte[] bytes)
        {
            StringBuilder text = new StringBuilder();
            StringBuilder currentWord = new StringBuilder();
            
            // OLE Compound Documentからテキストを抽出
            for (int i = 0; i < bytes.Length - 1; i++)
            {
                // Unicode文字を探す（日本語対応）
                if (i < bytes.Length - 1)
                {
                    // UTF-16LE形式のテキストを検出
                    byte b1 = bytes[i];
                    byte b2 = bytes[i + 1];
                    
                    // ASCII範囲の文字（UTF-16LE）
                    if (b2 == 0 && b1 >= 32 && b1 <= 126)
                    {
                        currentWord.Append((char)b1);
                        i++; // 次のバイトをスキップ
                    }
                    // 日本語文字（UTF-16LE）
                    else if (b2 >= 0x30 && b2 <= 0x9F)
                    {
                        char c = (char)(b1 | (b2 << 8));
                        currentWord.Append(c);
                        i++; // 次のバイトをスキップ
                    }
                    // 改行
                    else if (b1 == 0x0D || b1 == 0x0A)
                    {
                        if (currentWord.Length > 0)
                        {
                            text.AppendLine(currentWord.ToString());
                            currentWord.Clear();
                        }
                    }
                    else
                    {
                        if (currentWord.Length > 2)
                        {
                            string word = currentWord.ToString();
                            if (!IsGibberish(word))
                            {
                                text.Append(word);
                                text.Append(" ");
                            }
                        }
                        currentWord.Clear();
                    }
                }
            }

            if (currentWord.Length > 0)
            {
                text.Append(currentWord.ToString());
            }

            return CleanExtractedText(text.ToString());
        }

        private bool IsGibberish(string text)
        {
            if (string.IsNullOrEmpty(text)) return true;
            
            // 制御文字やバイナリデータらしい文字列をフィルタ
            int invalidChars = text.Count(c => c < 32 || (c > 126 && c < 160 && !IsJapaneseChar(c)));
            return invalidChars > text.Length / 3;
        }

        private bool IsJapaneseChar(char c)
        {
            // ひらがな、カタカナ、漢字の範囲
            return (c >= 0x3040 && c <= 0x309F) || // ひらがな
                   (c >= 0x30A0 && c <= 0x30FF) || // カタカナ
                   (c >= 0x4E00 && c <= 0x9FFF) || // CJK統合漢字
                   (c >= 0xFF00 && c <= 0xFFEF);   // 全角記号
        }

        private string CleanExtractedText(string text)
        {
            // 連続するスペースを1つに
            text = Regex.Replace(text, @"[ \t]+", " ");
            // 連続する改行を2つに
            text = Regex.Replace(text, @"\n{3,}", "\n\n");
            // 明らかなゴミを除去
            text = Regex.Replace(text, @"[\x00-\x08\x0B\x0C\x0E-\x1F]+", "");
            return text.Trim();
        }

        private string ConvertPdfToMarkdown(string filePath)
        {
            StringBuilder markdown = new StringBuilder();
            markdown.AppendLine($"# {Path.GetFileNameWithoutExtension(filePath)}");
            markdown.AppendLine();

            try
            {
                byte[] pdfBytes = File.ReadAllBytes(filePath);
                string pdfText = ExtractTextFromPdf(pdfBytes);

                if (string.IsNullOrWhiteSpace(pdfText))
                {
                    markdown.AppendLine("> このPDFからテキストを抽出できませんでした。");
                    markdown.AppendLine("> 画像ベースのPDFの可能性があります。");
                }
                else
                {
                    string[] lines = pdfText.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
                    foreach (string line in lines)
                    {
                        string trimmedLine = line.Trim();
                        if (!string.IsNullOrEmpty(trimmedLine))
                        {
                            markdown.AppendLine(trimmedLine);
                            markdown.AppendLine();
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                markdown.AppendLine($"> PDF読み取りエラー: {ex.Message}");
            }

            return markdown.ToString();
        }

        private string ExtractTextFromPdf(byte[] pdfBytes)
        {
            StringBuilder text = new StringBuilder();
            string content = Encoding.GetEncoding("ISO-8859-1").GetString(pdfBytes);

            // PDFストリームからテキストを抽出
            // BT...ET ブロック内のテキストオブジェクトを探す
            var matches = Regex.Matches(content, @"BT\s*(.*?)\s*ET", RegexOptions.Singleline);

            foreach (Match match in matches)
            {
                string block = match.Groups[1].Value;
                
                // Tj オペレータ（テキスト表示）
                var tjMatches = Regex.Matches(block, @"\((.*?)\)\s*Tj", RegexOptions.Singleline);
                foreach (Match tj in tjMatches)
                {
                    string extracted = DecodeTextString(tj.Groups[1].Value);
                    if (!string.IsNullOrWhiteSpace(extracted))
                    {
                        text.Append(extracted);
                    }
                }

                // TJ オペレータ（配列形式のテキスト）
                var tjArrayMatches = Regex.Matches(block, @"\[(.*?)\]\s*TJ", RegexOptions.Singleline);
                foreach (Match tjArray in tjArrayMatches)
                {
                    var stringMatches = Regex.Matches(tjArray.Groups[1].Value, @"\((.*?)\)");
                    foreach (Match str in stringMatches)
                    {
                        string extracted = DecodeTextString(str.Groups[1].Value);
                        if (!string.IsNullOrWhiteSpace(extracted))
                        {
                            text.Append(extracted);
                        }
                    }
                }
            }

            // ストリームから圧縮されていないテキストも探す
            if (text.Length == 0)
            {
                // シンプルなテキスト抽出を試みる
                var streamMatches = Regex.Matches(content, @"stream\s*(.*?)\s*endstream", RegexOptions.Singleline);
                foreach (Match streamMatch in streamMatches)
                {
                    string streamContent = streamMatch.Groups[1].Value;
                    // ASCII印刷可能文字のみ抽出
                    foreach (char c in streamContent)
                    {
                        if ((c >= 32 && c <= 126) || c == '\n' || c == '\r')
                        {
                            text.Append(c);
                        }
                    }
                }
            }

            return CleanExtractedText(text.ToString());
        }

        private string DecodeTextString(string input)
        {
            StringBuilder result = new StringBuilder();
            
            for (int i = 0; i < input.Length; i++)
            {
                char c = input[i];
                
                // エスケープシーケンスの処理
                if (c == '\\' && i + 1 < input.Length)
                {
                    char next = input[i + 1];
                    switch (next)
                    {
                        case 'n':
                            result.Append('\n');
                            i++;
                            break;
                        case 'r':
                            result.Append('\r');
                            i++;
                            break;
                        case 't':
                            result.Append('\t');
                            i++;
                            break;
                        case '\\':
                        case '(':
                        case ')':
                            result.Append(next);
                            i++;
                            break;
                        default:
                            // 8進数エスケープ
                            if (char.IsDigit(next))
                            {
                                string octal = "";
                                int j = i + 1;
                                while (j < input.Length && j < i + 4 && char.IsDigit(input[j]) && input[j] < '8')
                                {
                                    octal += input[j];
                                    j++;
                                }
                                if (octal.Length > 0)
                                {
                                    result.Append((char)Convert.ToInt32(octal, 8));
                                    i = j - 1;
                                }
                            }
                            break;
                    }
                }
                else if (c >= 32 && c <= 126)
                {
                    result.Append(c);
                }
            }

            return result.ToString();
        }

        private Encoding DetectEncoding(string filePath)
        {
            byte[] bom = new byte[4];
            using (FileStream fs = new FileStream(filePath, FileMode.Open, FileAccess.Read))
            {
                fs.Read(bom, 0, 4);
            }

            if (bom[0] == 0xef && bom[1] == 0xbb && bom[2] == 0xbf)
                return Encoding.UTF8;
            if (bom[0] == 0xff && bom[1] == 0xfe)
                return Encoding.Unicode;
            if (bom[0] == 0xfe && bom[1] == 0xff)
                return Encoding.BigEndianUnicode;
            if (bom[0] == 0xff && bom[1] == 0xfe && bom[2] == 0 && bom[3] == 0)
                return Encoding.UTF32;

            // デフォルトはShift-JIS（日本語環境向け）
            try
            {
                return Encoding.GetEncoding("shift_jis");
            }
            catch
            {
                return Encoding.UTF8;
            }
        }

        private void UpdateStatus(string message)
        {
            if (InvokeRequired)
            {
                Invoke(new Action(() => lblStatus.Text = message));
            }
            else
            {
                lblStatus.Text = message;
            }
        }

        private void UpdateProgress(int value)
        {
            if (InvokeRequired)
            {
                Invoke(new Action(() => progressBar.Value = value));
            }
            else
            {
                progressBar.Value = value;
            }
        }

        private void AppendLog(string message)
        {
            if (InvokeRequired)
            {
                Invoke(new Action(() =>
                {
                    txtLog.AppendText($"[{DateTime.Now:HH:mm:ss}] {message}{Environment.NewLine}");
                }));
            }
            else
            {
                txtLog.AppendText($"[{DateTime.Now:HH:mm:ss}] {message}{Environment.NewLine}");
            }
        }
